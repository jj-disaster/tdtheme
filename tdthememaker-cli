#!/bin/sh
# Convenience wrapper so the authoring tool can be run as
# `tdthememaker <command>` from any directory, for the same reason `tdtheme`
# is: the working directory should not be part of the command.
#
# The file is not named `tdthememaker` because the Python package already owns
# that name in this directory. It is meant to be symlinked onto PATH under the
# name the tool is actually called by, which is the only name that matters at
# the prompt:
#
#     ln -s "$PWD/tdthememaker-cli" /opt/homebrew/bin/tdthememaker
#
# The symlink loop is the same one `tdtheme` uses, and has to be: this script is
# meant to be symlinked onto PATH, where $0 is the symlink rather than this
# file, so `dirname $0` alone would name the directory holding the link. macOS
# has no `readlink -f`, hence the loop. Two copies of it rather than a shared
# sourced file, because a missing or renamed common file would break both
# commands at once, and the tests hold the two in agreement instead.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *) target=$(dirname -- "$target")/$link ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)

# On PYTHONPATH rather than `cd`. `tdthememaker/cli.py` uses relative imports,
# so it has to be run as a module of an importable package, and putting the
# repository on the path achieves that without moving the caller - which also
# keeps a relative path they pass, such as `preview --out sheet.png`, meaning
# what they meant.
if [ -n "$PYTHONPATH" ]; then
    PYTHONPATH="$here:$PYTHONPATH"
else
    PYTHONPATH="$here"
fi
export PYTHONPATH

# The same interpreter fallback `tdtheme` has, and for the same reason: a
# `python3` on PATH can exist and be executable while not running at all, which
# is exactly what the Command Line Tools stub is. `command -v` cannot tell the
# difference. The probe runs the candidate, because a bare -V is not proof
# either. Two copies of it rather than a shared sourced file, because a missing
# or renamed common file would break both commands at once, and the tests hold
# the two in agreement instead.
usable() {
    command -v "$1" >/dev/null 2>&1 && "$1" -c '' >/dev/null 2>&1
}

py=python3
if ! usable "$py"; then
    for candidate in \
        /Applications/TouchDesigner.app/Contents/Frameworks/Python.framework/Versions/*/bin/python3
    do
        if [ -x "$candidate" ] && "$candidate" -c '' >/dev/null 2>&1; then
            py=$candidate
            break
        fi
    done
fi
if ! usable "$py"; then
    if command -v python3 >/dev/null 2>&1; then
        echo "tdthememaker: the python3 on your PATH is present but does not run." >&2
        echo "tdthememaker: that is the Command Line Tools stub. Install the real" >&2
        echo "tdthememaker: one with 'xcode-select --install'." >&2
    else
        echo "tdthememaker: no python3 on PATH, and no TouchDesigner interpreter." >&2
        echo "tdthememaker: install the Command Line Tools with 'xcode-select --install'," >&2
        echo "tdthememaker: or install TouchDesigner, then try again." >&2
    fi
    exit 127
fi

exec "$py" -m tdthememaker.cli "$@"
