# Transient runtime state - regenerable, not source
.applied.json
.tdwrite-snapshot
__pycache__/
*.pyc

# PNG contact sheets, rewritten by every `icons preview` run
testiconsforagents/

# Backups are copies of a live TouchDesigner install, created on every apply
backups/

# macOS
.DS_Store

# JetBrains IDEs. These appear when a theme directory is opened as a project
# root by accident - the .iml and vcs.xml are per-machine, and workspace.xml
# holds local window state. Nothing here is source.
.idea/
