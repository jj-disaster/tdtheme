# Transient runtime state - regenerable, not source
.applied.json
.tdwrite-snapshot
__pycache__/
*.pyc

# PNG contact sheets, rewritten by every `icons preview` run
testiconsforagents/

# Backups are copies of a live TouchDesigner install, created on every apply
backups/

# A private baseline for a TouchDesigner build other than the one the committed
# `baseline/` was captured from, written by `tdtheme capture --local`. Local to
# one machine by definition - capturing it is the whole point - so it is never
# committed. Delete it to go back to the shipped baseline.
baseline.local/

# macOS
.DS_Store

# JetBrains IDEs. These appear when a theme directory is opened as a project
# root by accident - the .iml and vcs.xml are per-machine, and workspace.xml
# holds local window state. Nothing here is source.
.idea/
