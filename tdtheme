#!/bin/sh
# Convenience wrapper so the tool can be run as `tdtheme <command>` from any
# directory, without worrying about the interpreter or the working directory.
#
# Resolving $0 is not enough on its own: this script is meant to be symlinked
# onto PATH, and then $0 is the symlink, not this file. `dirname $0` would
# point at the directory holding the link, where cli.py does not exist. So
# follow the chain to the real file first. macOS has no `readlink -f`, hence
# the loop.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *) target=$(dirname -- "$target")/$link ;;
    esac
done
here=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)

# Pick an interpreter. `python3` from PATH is the right answer when it works, and
# on a Mac without the Command Line Tools `/usr/bin/python3` is only a 118 KB stub
# that opens a GUI installer instead of running anything - so "it exists on PATH"
# is not the same question as "it runs".
#
# The fallback is TouchDesigner's own bundled interpreter. Using this tool at all
# means TouchDesigner is installed, and it always ships a full CPython with PyYAML
# alongside, so this is a dependency the user already has rather than a new one.
# Checked explicitly and first-listed after python3 so a working PATH still wins.
py=python3
if ! command -v "$py" >/dev/null 2>&1; then
    for candidate in \
        /Applications/TouchDesigner.app/Contents/Frameworks/Python.framework/Versions/*/bin/python3
    do
        if [ -x "$candidate" ]; then
            py=$candidate
            break
        fi
    done
fi
if ! command -v "$py" >/dev/null 2>&1; then
    echo "tdtheme: no python3 found on PATH, and no TouchDesigner interpreter" >&2
    echo "tdtheme: install the Command Line Tools with 'xcode-select --install'," >&2
    echo "tdtheme: or install TouchDesigner, then try again." >&2
    exit 127
fi
exec "$py" "$here/cli.py" "$@"
